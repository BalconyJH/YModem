<Window x:Class="YModemWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YModem WPF" Height="380" Width="980" MinHeight="360" MinWidth="920">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Text="Port" />
            <ComboBox x:Name="PortComboBox" Width="180" Margin="8,0,0,0" />
            <Button Content="Refresh" Margin="8,0,0,0" Padding="10,3" Click="OnRefreshPortsClick" />
            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Text="Baud" />
            <TextBox x:Name="BaudRateTextBox" Width="120" Margin="8,0,0,0" Text="115200" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Send File" />
            <TextBox x:Name="SendFileTextBox" Width="560" Margin="8,0,0,0" />
            <Button Content="Browse" Margin="8,0,0,0" Padding="10,3" Click="OnBrowseSendFileClick" />
            <CheckBox x:Name="SendTimeoutCheckBox" Margin="8,2,0,0" IsChecked="True" Content="Timeout" />
            <Button Content="Start Send" Margin="8,0,0,0" Padding="10,3" Click="OnStartSendClick" />
        </StackPanel>

        <ProgressBar x:Name="SendProgressBar" Grid.Row="2" Minimum="0" Maximum="100" Height="14" />
        <TextBlock x:Name="SendStatusTextBlock" Grid.Row="3" Margin="0,6,0,10" Text="Send status: idle" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Save Folder" />
            <TextBox x:Name="SaveFolderTextBox" Width="560" Margin="8,0,0,0" />
            <Button Content="Browse" Margin="8,0,0,0" Padding="10,3" Click="OnBrowseSaveFolderClick" />
            <CheckBox x:Name="ReceiveTimeoutCheckBox" Margin="8,2,0,0" IsChecked="True" Content="Timeout" />
            <Button Content="Start Receive" Margin="8,0,0,0" Padding="10,3" Click="OnStartReceiveClick" />
        </StackPanel>

        <ProgressBar x:Name="ReceiveProgressBar" Grid.Row="5" Minimum="0" Maximum="100" Height="14" />
        <TextBlock x:Name="ReceiveStatusTextBlock" Grid.Row="6" Margin="0,6,0,10" Text="Receive status: idle" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Cancel Current Task" Padding="10,3" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
