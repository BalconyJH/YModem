<Window
    x:Class="YModemWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="YModem WinUI">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0">
            <TextBlock VerticalAlignment="Center" Text="Port" />
            <ComboBox x:Name="PortComboBox" Width="180" />
            <Button Content="Refresh" Click="OnRefreshPortsClick" />
            <TextBlock VerticalAlignment="Center" Text="Baud" />
            <TextBox x:Name="BaudRateTextBox" Width="120" Text="115200" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="1">
            <TextBlock VerticalAlignment="Center" Text="Send File" />
            <TextBox x:Name="SendFileTextBox" Width="560" PlaceholderText="Input full file path" />
            <CheckBox x:Name="SendTimeoutCheckBox" Content="Timeout" IsChecked="True" />
            <Button Content="Start Send" Click="OnStartSendClick" />
        </StackPanel>

        <ProgressBar x:Name="SendProgressBar" Grid.Row="2" Minimum="0" Maximum="100" Height="14" />
        <TextBlock x:Name="SendStatusTextBlock" Grid.Row="3" Text="Send status: idle" />

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="4">
            <TextBlock VerticalAlignment="Center" Text="Save Folder" />
            <TextBox x:Name="SaveFolderTextBox" Width="560" />
            <CheckBox x:Name="ReceiveTimeoutCheckBox" Content="Timeout" IsChecked="True" />
            <Button Content="Start Receive" Click="OnStartReceiveClick" />
        </StackPanel>

        <ProgressBar x:Name="ReceiveProgressBar" Grid.Row="5" Minimum="0" Maximum="100" Height="14" />
        <TextBlock x:Name="ReceiveStatusTextBlock" Grid.Row="6" Text="Receive status: idle" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
            <Button Content="Cancel Current Task" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
