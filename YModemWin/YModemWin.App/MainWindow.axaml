<faWindowing:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:faControls="using:FluentAvalonia.UI.Controls"
        xmlns:faWindowing="using:FluentAvalonia.UI.Windowing"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="YModemWin.MainWindow"
        Title="YModem"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="760"
        Icon="/Assets/YModem.png">
  <faWindowing:AppWindow.Styles>
    <Style Selector="ToggleButton.NavTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="ToggleButton.NavTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>

    <Style Selector="ToggleButton.NavTab:checked">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </faWindowing:AppWindow.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0">
    <Border Grid.Row="0"
            Height="40"
            Padding="12,0">
      <Grid x:Name="TitleBarHost" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <Image Width="16"
                 Height="16"
                 Source="/Assets/YModem.png"
                 VerticalAlignment="Center" />

          <TextBlock VerticalAlignment="Center">
            <Run Text="YModem"
                 FontSize="14"
                 FontWeight="SemiBold" />
            <Run Text=" Insider"
                 FontSize="10" />
          </TextBlock>
        </StackPanel>

        <Border Grid.Column="2"
                x:Name="TitleBarRightInsetSpacer"
                Width="0" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="16,10,16,10" Padding="12" CornerRadius="10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Port" />
        <ComboBox x:Name="PortComboBox" Grid.Column="1" Width="170" Margin="0,0,16,0" />

        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" Text="Baud" />
        <ComboBox x:Name="BaudRateComboBox" Grid.Column="3" Width="140" Margin="0,0,16,0">
          <ComboBoxItem Content="9600" />
          <ComboBoxItem Content="19200" />
          <ComboBoxItem Content="38400" />
          <ComboBoxItem Content="57600" />
          <ComboBoxItem Content="115200" />
          <ComboBoxItem Content="230400" />
          <ComboBoxItem Content="460800" />
          <ComboBoxItem Content="921600" />
        </ComboBox>

        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0" Text="Language" />
        <ComboBox x:Name="LanguageComboBox" Grid.Column="5" Width="150" Margin="0,0,16,0" SelectionChanged="OnLanguageSelectionChanged">
          <ComboBoxItem Content="English" Tag="en-US" />
          <ComboBoxItem Content="Chinese (Simplified)" Tag="zh-CN" />
        </ComboBox>

        <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,0" Text="Theme" />
        <ComboBox x:Name="ThemeComboBox" Grid.Column="7" Width="130" Margin="0,0,16,0" SelectionChanged="OnThemeSelectionChanged">
          <ComboBoxItem Content="Dark" Tag="Dark" />
          <ComboBoxItem Content="Light" Tag="Light" />
          <ComboBoxItem Content="System" Tag="Default" />
        </ComboBox>

        <Button Grid.Column="8" Content="Refresh Ports" Click="OnRefreshPortsClick" />
      </Grid>
    </Border>

    <faControls:InfoBar Grid.Row="2"
                        x:Name="MainInfoBar"
                        IsOpen="False"
                        IsClosable="True"
                        Margin="16,0,16,10"
                        Severity="Informational"
                        Message="Ready." />

    <Border Grid.Row="3" Margin="16,0,16,10" Padding="12" CornerRadius="10">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
          <ToggleButton x:Name="SendPageButton" Classes="NavTab" Content="Send" Click="OnNavigateSendPageClick" />
          <ToggleButton x:Name="ReceivePageButton" Grid.Column="1" Classes="NavTab" Content="Receive" Click="OnNavigateReceivePageClick" />
        </Grid>

        <ui:Frame Name="TestFrame" Margin="0,8,0,0" />
      </DockPanel>
    </Border>

    <Border Grid.Row="4" Margin="16,0,16,10" Padding="10" CornerRadius="10">
      <Grid RowDefinitions="Auto,Auto,Auto">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <TextBlock Text="Transfer Progress" Opacity="0.8" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" x:Name="TransferProgressTextBlock" Text="Idle" />
        </Grid>
        <ProgressBar Grid.Row="1" Margin="0,8,0,0" x:Name="TransferProgressBar" Minimum="0" Maximum="100" Height="8">
          <ProgressBar.Transitions>
            <Transitions>
              <DoubleTransition Property="Value" Duration="0:0:0.18" />
            </Transitions>
          </ProgressBar.Transitions>
        </ProgressBar>
        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="*,*,*,*">
          <TextBlock x:Name="SendBytesTextBlock" Text="Send Bytes: 0/0" />
          <TextBlock Grid.Column="1" x:Name="SendPacketsTextBlock" Text="Send Packets: 0/0" />
          <TextBlock Grid.Column="2" x:Name="ReceiveBytesTextBlock" Text="Receive Bytes: 0/0" />
          <TextBlock Grid.Column="3" x:Name="ReceivePacketsTextBlock" Text="Receive Packets: 0/0" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="5" Margin="16,0,16,16" Padding="10" CornerRadius="10">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Runtime Logs" />
          <CheckBox Grid.Column="1" x:Name="AutoScrollLogCheckBox" Margin="0,0,10,0" IsChecked="True" Content="Auto Scroll" />
          <Button Grid.Column="2" Content="Clear Logs" Click="OnClearLogClick" />
        </Grid>

        <TextBox Grid.Row="1" x:Name="RuntimeLogTextBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" Height="170" />
      </Grid>
    </Border>
  </Grid>
</faWindowing:AppWindow>
