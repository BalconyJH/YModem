<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <RootNamespace>YModemWin</RootNamespace>
        <AssemblyName>YModem</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Sentry" Version="6.1.0"/>
        <PackageReference Include="Sentry.Profiling" Version="6.1.0"/>
        <PackageReference Include="Serilog" Version="4.2.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0"/>
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0"/>
        <PackageReference Include="DeviceProgramming" Version="1.0.8"/>
        <PackageReference Include="WPF-UI" Version="4.2.0"/>
        <PackageReference Include="System.IO.Ports" Version="10.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\YModemWin.Core\YModemWin.Core.csproj" />
    </ItemGroup>


    <ItemGroup>
        <Content Include="$(NuGetPackageRoot)wpf-ui/4.2.0/**/en-US/Wpf.Ui.resources.dll"
                 Link="en-US/Wpf.Ui.resources.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 Visible="false" />
        <Content Include="$(NuGetPackageRoot)wpf-ui/4.2.0/**/zh-CN/Wpf.Ui.resources.dll"
                 Link="zh-CN/Wpf.Ui.resources.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 Visible="false" />
    </ItemGroup>

</Project>
