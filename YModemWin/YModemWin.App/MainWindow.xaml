<Window
    x:Class="YModemWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="PortLabelTextBlock" VerticalAlignment="Center" />
            <ComboBox x:Name="PortComboBox" Width="140" DropDownOpened="OnSerialComboBoxDropDownOpened" />
            <Button x:Name="RefreshPortsButton" Click="OnRefreshPortsClick" />
            <TextBlock x:Name="BaudRateLabelTextBlock" VerticalAlignment="Center" Margin="8,0,0,0" />
            <ComboBox x:Name="BaudRateComboBox" Width="120" DropDownOpened="OnSerialComboBoxDropDownOpened">
                <ComboBoxItem Content="9600" />
                <ComboBoxItem Content="19200" />
                <ComboBoxItem Content="38400" />
                <ComboBoxItem Content="57600" />
                <ComboBoxItem Content="115200" />
            </ComboBox>
            <CheckBox x:Name="SendTimeoutCheckBox" IsChecked="True" />
            <ComboBox x:Name="SendTimeoutComboBox" Width="90" DropDownOpened="OnSerialComboBoxDropDownOpened">
                <ComboBoxItem Content="0s" />
                <ComboBoxItem Content="1s" />
                <ComboBoxItem Content="2s" />
                <ComboBoxItem Content="4s" />
            </ComboBox>
            <CheckBox x:Name="ReceiveTimeoutCheckBox" IsChecked="True" />
            <ComboBox x:Name="ReceiveTimeoutComboBox" Width="90" DropDownOpened="OnSerialComboBoxDropDownOpened">
                <ComboBoxItem Content="0s" />
                <ComboBoxItem Content="1s" />
                <ComboBoxItem Content="2s" />
                <ComboBoxItem Content="4s" />
            </ComboBox>
            <CheckBox x:Name="SendParsedSegmentsCheckBox" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock x:Name="SendSectionTextBlock" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddSendFileButton" Click="OnBrowseSendFileClick" />
                    <Button x:Name="DeleteSendFilesButton" Click="OnDeleteSendFilesClick" />
                    <Button x:Name="SendActionButton" Click="OnStartSendClick" />
                </StackPanel>
                <ListView x:Name="SendFilesListView" Height="180" SelectionMode="Extended" KeyDown="OnSendFilesListKeyDown" />
                <muxc:InfoBar x:Name="SendInfoBar" IsOpen="False" Severity="Warning" />
                <ProgressBar x:Name="SendProgressBar" Height="6" Minimum="0" Maximum="100" />
                <TextBlock x:Name="SendStatusTextBlock" />
                <TextBlock x:Name="SendBytesTextBlock" />
                <TextBlock x:Name="SendPacketsTextBlock" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="ReceiveSectionTextBlock" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ReceiveActionButton" Click="OnStartReceiveClick" />
                    <TextBox x:Name="SaveFolderTextBox" Width="260" />
                    <Button x:Name="BrowseSaveFolderButton" Click="OnBrowseSaveFolderClick" />
                </StackPanel>
                <TextBlock x:Name="ReceiveFileNameTextBlock" />
                <TextBlock x:Name="ReceiveFileDateTextBlock" />
                <ProgressBar x:Name="ReceiveProgressBar" Height="6" Minimum="0" Maximum="100" />
                <TextBlock x:Name="ReceiveStatusTextBlock" />
                <TextBlock x:Name="ReceiveBytesTextBlock" />
                <TextBlock x:Name="ReceivePacketsTextBlock" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ClearLogButton" Click="OnClearLogClick" />
            </StackPanel>
            <TextBox x:Name="RuntimeLogTextBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" Height="160" />
        </StackPanel>
    </Grid>
</Window>
