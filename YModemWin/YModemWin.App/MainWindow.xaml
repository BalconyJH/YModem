<ui:FluentWindow x:Class="YModemWin.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="YModem WPF"
                 Height="720"
                 Width="1200"
                 MinHeight="680"
                 MinWidth="1100"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <CornerRadius x:Key="CardRadius">12</CornerRadius>

        <!-- 关键：覆盖 Wpf.Ui 主题里的全局控件圆角，ComboBox/TextBox/按钮等会统一 -->
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

        <Thickness x:Key="CardPadding">18</Thickness>
        <Thickness x:Key="SectionGap">0,0,0,12</Thickness>

        <Thickness x:Key="IconNudge">0,1,0,0</Thickness>

        <Style x:Key="CardContainer" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="ToolbarButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="ReadableSecondaryButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource ReadableSecondaryButtonStyle}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Width" Value="140" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="YModem WPF" />

        <Grid Grid.Row="1" Margin="20,12,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Serial Configuration -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardContainer}"
                    Margin="{StaticResource SectionGap}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0"
                                  FontTypography="BodyStrong"
                                  Text="Serial Configuration"
                                  Margin="0,0,0,14" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:TextBlock VerticalAlignment="Center"
                                          Text="Port:"
                                          Margin="0,0,10,0"
                                          MinWidth="40" />
                            <ComboBox x:Name="PortComboBox"
                                      Width="170"
                                      Height="38"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,10,0" />
                            <ui:Button Content="Refresh"
                                       Style="{StaticResource ReadableSecondaryButtonStyle}"
                                       Appearance="Secondary"
                                       Click="OnRefreshPortsClick" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:TextBlock VerticalAlignment="Center"
                                          Text="Baud Rate:"
                                          Margin="0,0,10,0"
                                          MinWidth="76" />
                            <ComboBox x:Name="BaudRateComboBox"
                                      Width="140"
                                      Height="38"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="9600" />
                                <ComboBoxItem Content="19200" />
                                <ComboBoxItem Content="38400" />
                                <ComboBoxItem Content="57600" />
                                <ComboBoxItem Content="115200" />
                                <ComboBoxItem Content="230400" />
                                <ComboBoxItem Content="460800" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="SendTimeoutCheckBox"
                                      IsChecked="True"
                                      Content="Send Timeout"
                                      Margin="0,0,18,0"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ReceiveTimeoutCheckBox"
                                      IsChecked="True"
                                      Content="Receive Timeout"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Send / Receive -->
            <Grid Grid.Row="1" Margin="{StaticResource SectionGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Send -->
                <Border Grid.Column="0" Style="{StaticResource CardContainer}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Grid.Column="0"
                                          FontTypography="BodyStrong"
                                          Text="Send Files"
                                          VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ui:Button Content="Add"
                                           Style="{StaticResource ReadableSecondaryButtonStyle}"
                                           Appearance="Secondary"
                                           Click="OnBrowseSendFileClick">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Add24"
                                                       FontSize="16"
                                                       Margin="{StaticResource IconNudge}"
                                                       VerticalAlignment="Center" />
                                    </ui:Button.Icon>
                                </ui:Button>

                                <ui:Button Content="Clear"
                                           Style="{StaticResource ReadableSecondaryButtonStyle}"
                                           Appearance="Secondary"
                                           Margin="8,0,0,0"
                                           Click="OnClearSendFilesClick">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24"
                                                       FontSize="16"
                                                       Margin="{StaticResource IconNudge}"
                                                       VerticalAlignment="Center" />
                                    </ui:Button.Icon>
                                </ui:Button>

                                <ui:Button x:Name="SendActionButton"
                                           Content="Start Send"
                                           Style="{StaticResource ActionButtonStyle}"
                                           MinWidth="120"
                                           Margin="8,0,0,0"
                                           Click="OnStartSendClick">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowUpload24"
                                                       FontSize="16"
                                                       Margin="{StaticResource IconNudge}"
                                                       VerticalAlignment="Center" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,0,0,14"
                                Padding="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ListBox x:Name="SendFilesListBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" />
                        </Border>

                        <StackPanel Grid.Row="2">
                            <ui:InfoBar x:Name="SendInfoBar"
                                        IsOpen="False"
                                        Severity="Warning"
                                        Title="提示"
                                        Message="请至少选择一个文件再开始发送。"
                                        Margin="0,0,0,10"/>
                            <ProgressBar x:Name="SendProgressBar"
                                         Background="Transparent"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="8"
                                         Margin="0,0,0,12" />
                            <ui:TextBlock x:Name="SendStatusTextBlock"
                                          Text="Send status: idle"
                                          Margin="0,0,0,10"
                                          FontSize="13" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock x:Name="SendBytesTextBlock"
                                              Grid.Column="0"
                                              Text="Bytes: 0/0"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock x:Name="SendPacketsTextBlock"
                                              Grid.Column="1"
                                              Text="Packets: 0/0"
                                              HorizontalAlignment="Right"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Receive -->
                <Border Grid.Column="2" Style="{StaticResource CardContainer}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Grid.Column="0"
                                          FontTypography="BodyStrong"
                                          Text="Receive Files"
                                          VerticalAlignment="Center" />

                            <ui:Button x:Name="ReceiveActionButton"
                                       Grid.Column="1"
                                       Content="Start Receive"
                                       Style="{StaticResource ActionButtonStyle}"
                                       MinWidth="120"
                                       Click="OnStartReceiveClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload24"
                                                   FontSize="16"
                                                   Margin="{StaticResource IconNudge}"
                                                   VerticalAlignment="Center" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox x:Name="SaveFolderTextBox"
                                        Grid.Column="0"
                                        Height="38"
                                        VerticalContentAlignment="Center"
                                        Padding="12,0"
                                        PlaceholderText="Save folder path"
                                        Margin="0,0,8,0" />

                            <ui:Button Grid.Column="1"
                                       Content="Browse"
                                       Style="{StaticResource ReadableSecondaryButtonStyle}"
                                       Appearance="Secondary"
                                       Click="OnBrowseSaveFolderClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Folder24"
                                                   FontSize="16"
                                                   Margin="{StaticResource IconNudge}"
                                                   VerticalAlignment="Center" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <Border Grid.Row="2"
                                Margin="0,0,0,14"
                                Padding="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ui:TextBlock x:Name="ReceiveFileNameTextBlock"
                                              Grid.Row="0"
                                              Text="File: -"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="0,0,0,6" />
                                <ui:TextBlock x:Name="ReceiveFileDateTextBlock"
                                              Grid.Row="1"
                                              Text="Date: -"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <ui:TextBlock Grid.Row="2"
                                              Text="Waiting for incoming transfer..."
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontSize="13"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3">
                            <ProgressBar x:Name="ReceiveProgressBar"
                                         Background="Transparent"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="8"
                                         Margin="0,0,0,12" />
                            <ui:TextBlock x:Name="ReceiveStatusTextBlock"
                                          Text="Receive status: idle"
                                          Margin="0,0,0,10"
                                          FontSize="13" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock x:Name="ReceiveBytesTextBlock"
                                              Grid.Column="0"
                                              Text="Bytes: 0/0"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock x:Name="ReceivePacketsTextBlock"
                                              Grid.Column="1"
                                              Text="Packets: 0/0"
                                              HorizontalAlignment="Right"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Runtime Log -->
            <Border Grid.Row="2" Style="{StaticResource CardContainer}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock Grid.Column="0"
                                      FontTypography="BodyStrong"
                                      Text="Runtime Log"
                                      VerticalAlignment="Center" />

                        <ui:Button Grid.Column="1"
                                   Content="Clear"
                                   Style="{StaticResource ReadableSecondaryButtonStyle}"
                                   Appearance="Secondary"
                                   Click="OnClearLogClick">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Broom24"
                                               FontSize="16"
                                               Margin="{StaticResource IconNudge}"
                                               VerticalAlignment="Center" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ui:TextBox x:Name="RuntimeLogTextBox"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>