<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling"
             x:Class="YModemWin.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <fa:FluentAvaloniaTheme PreferUserAccentColor="True" />

    <Style Selector="ComboBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox /template/ ContentPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem /template/ ContentPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
